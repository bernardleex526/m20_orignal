<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>m20_slam_navigation</name>
  <version>1.0.0</version>
  <description>
    Industrial-grade 3D LiDAR-Inertial SLAM, Relocalization, Terrain Traversability
    Analysis, and Autonomous Navigation system for quadruped robots (M20 Pro).
    Modules: LIO Frontend (iterated ESKF + hierarchical voxel point-plane update),
    Backend (GTSAM iSAM2 + Gravity + PGO),
    Prior Map Relocalization (NDT + ESKF), Terrain Analysis (2.5D Elevation Grid),
    Global Planner (Omnidirectional Hybrid A*), Local Controller (DWA + LinePlanner).
  </description>
  <maintainer email="bernardx526@example.com">bernardx526</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>libpcl-all-dev</depend>
  <depend>gtsam</depend>

  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
